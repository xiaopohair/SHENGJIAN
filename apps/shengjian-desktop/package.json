{
  "name": "shengjian-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\"",
    "format:write": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:installer": "tauri build && powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/normalize-installer-name.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-portable.ps1",
    "prepare:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-helper.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
